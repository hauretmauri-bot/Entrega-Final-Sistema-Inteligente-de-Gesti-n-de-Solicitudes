    {
      "parameters": {
        "jsCode": "const texto = $json.content.parts[0].text;\n\nconst datos = JSON.parse(texto);\n\nreturn [\n  {\n    json: {\n      ID_Solicitud: $('Registrar Solicitud').item.json.ID_Solicitud,\n      tipo: datos.tipo,\n      prioridad: datos.prioridad,\n      resumen_IA: datos.resumen,\n      respuesta_IA: datos.respuesta\n    }\n  }\n];"
      },
